                      <div
                        class="relative row-span-1 border-none"
                      >
                        <img
                          class="h-full w-fit object-cover"
                          data-pw="msb-gallery-image-3"
                          src="https://cdn.visenze.com/sample/sunset.jpg"
                        />
                      </div>
                      <div
                        class="relative row-span-1 border-none"
                      >
                        <img
                          class="h-full w-fit object-cover"
                          data-pw="msb-gallery-image-4"
                          src="https://cdn.visenze.com/sample/sport.jpg"
                        />
                      </div>
                      <div
                        class="relative row-span-1 border-none"
                      >
                        <img
                          class="h-full w-fit object-cover"
                          data-pw="msb-gallery-image-5"
                          src="https://cdn.visenze.com/sample/dance.jpg"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="z-10 flex w-full justify-center items-center sticky bottom-0 bg-primary py-2 md:absolute lg:rounded-b-3xl"
            data-pw="cs-visenze-footer"
          >
            <p
              class="text-xs"
            >
              POWERED BY 
            </p>
            <img
              class="h-5 object-center py-0.5 pl-1"
              src="https://cdn.visenze.com/images/visenze-logo-sm.png"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    data-react-modal-body-trap=""
    style="position: absolute; opacity: 0;"
    tabindex="0"
  />
</body>
