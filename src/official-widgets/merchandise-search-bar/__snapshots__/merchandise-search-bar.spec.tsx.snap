                  </div>
                </div>
              </div>
              <div
                class="py-5 md:w-2/3 md:border-l-2 md:border-gray-300 md:px-12 md:pt-0"
              >
                <p
                  class="px-14 pb-3 text-center text-primary md:px-0 md:text-left"
                >
                  tap to see images
                </p>
                <div
                  class="grid grid-cols-2 gap-2 px-5 md:gap-4 md:px-0"
                >
                  <div
                    class="col-span-1"
                  >
                    <div
                      class="relative h-full"
                    >
                      <img
                        class="h-full w-fit object-cover"
                        data-pw="msb-gallery-image-1"
                        src="https://cdn.visenze.com/sample/street_shot.jpg"
                      />
                    </div>
                  </div>
                  <div
                    class="col-span-1"
                  >
                    <div
                      class="grid grid-cols-2 gap-2 md:gap-4"
                    >
                      <div
                        class="relative row-span-1 border-none"
                      >
                        <img
                          class="h-full w-fit object-cover"
                          data-pw="msb-gallery-image-2"
                          src="https://cdn.visenze.com/sample/suit.jpg"
