exports[`icon-triggered-grid should render a custom icon if configured as such 1`] = `
<DocumentFragment>
  <button
    aria-label="CTA"
    class="wigmix-popup-trigger-button flex items-center gap-2 py-1 rounded-md px-1"
    data-testid="wigmix-popup-trigger-button"
    style="background-color: rgb(255, 255, 255);"
    type="button"
  >
    <div
      class="wigmix-popup-trigger-icon custom"
      style="height: 24px; width: 24px; background-image: url(https://trigger-icon); background-repeat: no-repeat; background-position: center; background-size: contain;"
    />
  </button>
</DocumentFragment>
`;

