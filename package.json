{
  "name": "visenze-experiences-web",
  "version": "0.0.1",
  "description": "A collection of widgets to instantly add ViSenze-powered product search functionality into websites",
  "scripts": {
    "build": "npm run build:camera-search && npm run build:similar-search && npm run build:search-results-page && npm run build:recommend-me && npm run build:more-like-this && npm run build:shop-the-look && npm run build:embedded-grid && npm run build:shoppable-lookbook && npm run build:icon-triggered-grid && npm run build:shoppable-gallery && npm run build:search-bar && npm run build:embedded-search-results",
    "build:staging": "export build=staging && npm run build",
    "build:init": "webpack --config webpack.init.js",
    "build:camera-search": "webpack --env dir=official-widgets/camera-search --config webpack.config.js",
    "start:camera-search": "webpack-dev-server --env dir=official-widgets/camera-search --config webpack.dev.js",
    "build:similar-search": "webpack --env dir=official-widgets/similar-search --config webpack.config.js",
    "start:similar-search": "webpack-dev-server --env dir=official-widgets/similar-search --config webpack.dev.js",
    "build:search-results-page": "webpack --env dir=official-widgets/search-results-page --config webpack.config.js",
    "start:search-results-page": "webpack-dev-server --env dir=official-widgets/search-results-page --config webpack.dev.js",
    "build:recommend-me": "webpack --env dir=official-widgets/recommend-me --config webpack.config.js",
    "start:recommend-me": "webpack-dev-server --env dir=official-widgets/recommend-me --config webpack.dev.js",
    "build:shopping-assistant": "webpack --env dir=official-widgets/shopping-assistant --config webpack.config.js",
    "start:shopping-assistant": "webpack-dev-server --env dir=official-widgets/shopping-assistant --config webpack.dev.js",
    "build:more-like-this": "webpack --env dir=official-widgets/more-like-this --config webpack.config.js",
    "start:more-like-this": "webpack-dev-server --env dir=official-widgets/more-like-this --config webpack.dev.js",
    "build:shop-the-look": "webpack --env dir=official-widgets/shop-the-look --config webpack.config.js",
    "start:shop-the-look": "webpack-dev-server --env dir=official-widgets/shop-the-look --config webpack.dev.js",
    "build:embedded-grid": "webpack --env dir=official-widgets/embedded-grid --config webpack.config.js",
    "start:embedded-grid": "webpack-dev-server --env dir=official-widgets/embedded-grid --config webpack.dev.js",
    "build:shoppable-lookbook": "webpack --env dir=official-widgets/shoppable-lookbook --config webpack.config.js",
    "start:shoppable-lookbook": "webpack-dev-server --env dir=official-widgets/shoppable-lookbook --config webpack.dev.js",
    "build:icon-triggered-grid": "webpack --env dir=official-widgets/icon-triggered-grid --config webpack.config.js",
    "start:icon-triggered-grid": "webpack-dev-server --env dir=official-widgets/icon-triggered-grid --config webpack.dev.js",
    "build:shoppable-gallery": "webpack --env dir=official-widgets/shoppable-gallery --config webpack.config.js",
    "start:shoppable-gallery": "webpack-dev-server --env dir=official-widgets/shoppable-gallery --config webpack.dev.js",
    "build:search-bar": "webpack --env dir=official-widgets/search-bar --config webpack.config.js",
    "start:search-bar": "webpack-dev-server --env dir=official-widgets/search-bar --config webpack.dev.js",
    "build:embedded-search-results": "webpack --env dir=official-widgets/embedded-search-results --config webpack.config.js",
    "start:embedded-search-results": "webpack-dev-server --env dir=official-widgets/embedded-search-results --config webpack.dev.js",
    "test": "jest ./tests",
    "test:coverage": "jest ./tests --coverage",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "prettier": "prettier --check './src'",
    "prettier:fix": "prettier --write './src'",
    "type-check": "tsc -p tsconfig.json",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visenze/visenze-experiences-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "bugs": {
    "url": "https://github.com/visenze/visenze-experiences-web/issues"
  },
  "homepage": "https://github.com/visenze/visenze-experiences-web#readme",
  "dependencies": {
    "@heroui/accordion": "^2.2.8",
    "@heroui/button": "^2.2.10",
    "@heroui/card": "^2.2.10",
    "@heroui/checkbox": "^2.3.9",
    "@heroui/chip": "^2.2.7",
    "@heroui/image": "^2.2.6",
    "@heroui/input": "^2.4.10",
    "@heroui/listbox": "^2.3.10",
    "@heroui/pagination": "^2.2.9",
    "@heroui/popover": "^2.3.10",
    "@heroui/radio": "^2.3.9",
    "@heroui/skeleton": "^2.2.6",
    "@heroui/slider": "^2.4.8",
    "@heroui/spacer": "^2.2.7",
    "@heroui/spinner": "^2.2.7",
    "@heroui/system": "^2.4.7",
    "@heroui/theme": "^2.4.6",
    "@microsoft/fetch-event-source": "^2.0.1",
    "framer-motion": "^12.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-intl": "^7.1.5",
    "react-modal": "^3.16.3",
    "react-responsive": "^10.0.0",
    "react-shadow": "^20.6.0",
    "react-slick": "^0.30.3",
    "react-swipeable": "^7.0.2",
    "slick-carousel": "^1.8.1",
    "typewriter-effect": "^2.21.0",
    "uuid": "^11.0.5",
    "visearch-javascript-sdk": "^5.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.7",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/react-dom": "^18.3.5",
    "@types/react-modal": "^3.16.3",
    "@types/react-slick": "^0.23.13",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "dotenv": "^16.4.7",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "eslint-webpack-plugin": "^4.2.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.1",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.4.2",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.4",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.17",
    "ts-loader": "^9.5.2",
    "typescript": "~5.5.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-s3-plugin": "^1.2.0-rc.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "npx eslint --ext .js,.jsx,.ts,.tsx"
  }
}
